-- One row per recording or photo in a note, its bytes in a file named by its id (AttachmentFiles).
-- on_server: its attachment is on the server, linked to the note's memo.
-- A deleted one stays as a tombstone (deleted = 1) until the server has forgotten it too.
CREATE TABLE attachment (
    id TEXT NOT NULL PRIMARY KEY,
    note_id TEXT NOT NULL,
    file_name TEXT NOT NULL,
    type TEXT NOT NULL,
    duration_ms INTEGER,
    created_at INTEGER NOT NULL,
    downloaded INTEGER AS kotlin.Boolean NOT NULL,
    on_server INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE INDEX attachment_note ON attachment(note_id);

visible:
SELECT * FROM attachment WHERE deleted = 0 ORDER BY created_at, rowid;

ofNote:
SELECT * FROM attachment WHERE note_id = ? AND deleted = 0 ORDER BY created_at, rowid;

byId:
SELECT * FROM attachment WHERE id = ?;

insertLocal:
INSERT INTO attachment(id, note_id, file_name, type, duration_ms, created_at, downloaded, on_server)
VALUES (?, ?, ?, ?, ?, ?, 1, 0);

insertFromServer:
INSERT OR IGNORE INTO attachment(id, note_id, file_name, type, created_at, downloaded, on_server)
VALUES (?, ?, ?, ?, ?, 0, 1);

-- One sent here whose reply was lost: the server has it.
markOnServer:
UPDATE attachment SET on_server = 1 WHERE id = ?;

-- The attachments of a note whose memo is on the server: whatever is not among the memo's was deleted there.
onServerOf:
SELECT id FROM attachment WHERE note_id = ? AND on_server = 1 AND deleted = 0;

-- Attachments to send: their note's memo exists to link them to.
toUpload:
SELECT attachment.* FROM attachment JOIN note ON note.id = attachment.note_id
WHERE attachment.deleted = 0 AND attachment.on_server = 0 AND attachment.downloaded = 1 AND note.on_server = 1 AND note.deleted = 0
ORDER BY attachment.created_at, attachment.rowid;

toDownload:
SELECT * FROM attachment WHERE deleted = 0 AND downloaded = 0 ORDER BY created_at, rowid;

toDelete:
SELECT id FROM attachment WHERE deleted = 1;

markDownloaded:
UPDATE attachment SET downloaded = 1 WHERE id = ?;

markDeleted:
UPDATE attachment SET deleted = 1 WHERE id = ?;

idsOfNote:
SELECT id FROM attachment WHERE note_id = ?;

forgetServer:
UPDATE attachment SET on_server = 0 WHERE note_id = ?;

forgetAllServers:
UPDATE attachment SET on_server = 0;

purge:
DELETE FROM attachment WHERE id = ?;
