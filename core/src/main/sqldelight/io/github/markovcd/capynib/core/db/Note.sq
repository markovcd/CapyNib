-- One row per note. A deleted note stays as a tombstone (deleted = 1) until the server has
-- forgotten it too. version counts local edits; synced_version is the version the server holds,
-- so a row with version > synced_version has edits to push. synced_* hold the memo as last seen
-- on the server, to tell a server-side edit from a local one. trashed_at is when the note went to
-- the trash; its memo is archived on the server until the trash is emptied of it (ADR 0006).
-- position orders the board, highest first, and is the memo's create time in epoch seconds;
-- synced_position is the server's (ADR 0008).
CREATE TABLE note (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    color TEXT NOT NULL,
    pinned INTEGER AS kotlin.Boolean NOT NULL,
    archived INTEGER AS kotlin.Boolean NOT NULL,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    synced_version INTEGER NOT NULL DEFAULT 0,
    on_server INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    synced_content TEXT,
    synced_pinned INTEGER AS kotlin.Boolean,
    synced_archived INTEGER AS kotlin.Boolean,
    trashed_at INTEGER,
    position INTEGER NOT NULL DEFAULT 0,
    synced_position INTEGER
);

CREATE INDEX note_created_at ON note(created_at);

visible:
SELECT * FROM note WHERE deleted = 0 ORDER BY pinned DESC, position DESC, id;

byId:
SELECT * FROM note WHERE id = ?;

pending:
SELECT * FROM note WHERE version != synced_version;

onServer:
SELECT * FROM note WHERE on_server = 1;

nextPosition:
SELECT COALESCE(MAX(position) + 1, 0) FROM note;

insertLocal:
INSERT INTO note(id, title, body, color, pinned, archived, created_at, updated_at, position, version, synced_version, on_server)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 0, 0);

insertFromServer:
INSERT INTO note(id, title, body, color, pinned, archived, created_at, updated_at, position, version, synced_version, on_server, synced_content, synced_pinned, synced_archived, synced_position)
VALUES (:id, :title, :body, :color, :pinned, :archived, :created_at, :updated_at, :position, 1, 1, 1, :synced_content, :pinned, :archived, :position);

updateLocal:
UPDATE note SET title = ?, body = ?, color = ?, pinned = ?, archived = ?, updated_at = ?, version = version + 1
WHERE id = ?;

trash:
UPDATE note SET trashed_at = :now, updated_at = :now, version = version + 1 WHERE id = :id AND trashed_at IS NULL;

move:
UPDATE note SET position = :position, version = version + 1 WHERE id = :id AND position != :position;

restore:
UPDATE note SET trashed_at = NULL, updated_at = :now, version = version + 1 WHERE id = :id AND trashed_at IS NOT NULL;

trashedBefore:
SELECT id FROM note WHERE deleted = 0 AND trashed_at <= ?;

markDeleted:
UPDATE note SET deleted = 1, updated_at = ?, version = version + 1 WHERE id = ?;

markPushed:
UPDATE note SET synced_version = :pushed_version, on_server = 1, synced_content = :content, synced_pinned = :pinned, synced_archived = :archived,
    synced_position = :position
WHERE id = :id;

-- A trashed note's memo is archived, so an archived memo leaves the note's own archived flag alone,
-- and a memo taken out of the archive elsewhere takes the note out of the trash.
applyServer:
UPDATE note SET title = :title, body = :body, color = :color, pinned = :pinned,
    archived = CASE WHEN trashed_at IS NOT NULL AND :archived THEN archived ELSE :archived END,
    trashed_at = CASE WHEN :archived THEN trashed_at ELSE NULL END,
    updated_at = :updated_at, position = :position,
    version = version + 1, synced_version = version + 1, synced_content = :synced_content, synced_pinned = :pinned, synced_archived = :archived,
    synced_position = :position
WHERE id = :id AND version = :expected_version;

acceptServer:
UPDATE note SET on_server = 1, synced_content = :synced_content, synced_pinned = :synced_pinned, synced_archived = :synced_archived,
    synced_position = :synced_position
WHERE id = :id;

forgetServer:
UPDATE note SET on_server = 0, synced_content = NULL, synced_pinned = NULL, synced_archived = NULL, synced_position = NULL WHERE id = :id;

-- Every note as never sent, so the next push creates each one on the server.
forgetAllServers:
UPDATE note SET on_server = 0, synced_version = 0, synced_content = NULL, synced_pinned = NULL, synced_archived = NULL, synced_position = NULL;

purge:
DELETE FROM note WHERE id = ?;
