-- One row per recording, its bytes in a file named by its id (RecordingFiles). on_server: its
-- attachment is on the server, linked to the note's memo.
-- A deleted recording stays as a tombstone (deleted = 1) until the server has forgotten it too.
CREATE TABLE recording (
    id TEXT NOT NULL PRIMARY KEY,
    note_id TEXT NOT NULL,
    file_name TEXT NOT NULL,
    type TEXT NOT NULL,
    duration_ms INTEGER,
    created_at INTEGER NOT NULL,
    downloaded INTEGER AS kotlin.Boolean NOT NULL,
    on_server INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE INDEX recording_note ON recording(note_id);

visible:
SELECT * FROM recording WHERE deleted = 0 ORDER BY created_at, id;

ofNote:
SELECT * FROM recording WHERE note_id = ? AND deleted = 0 ORDER BY created_at, id;

byId:
SELECT * FROM recording WHERE id = ?;

insertLocal:
INSERT INTO recording(id, note_id, file_name, type, duration_ms, created_at, downloaded, on_server)
VALUES (?, ?, ?, ?, ?, ?, 1, 0);

insertFromServer:
INSERT OR IGNORE INTO recording(id, note_id, file_name, type, created_at, downloaded, on_server)
VALUES (?, ?, ?, ?, ?, 0, 1);

-- A recording sent here whose reply was lost: the server has it.
markOnServer:
UPDATE recording SET on_server = 1 WHERE id = ?;

-- The recordings of a note whose attachments are on the server: whatever is not among them was deleted there.
onServerOf:
SELECT id FROM recording WHERE note_id = ? AND on_server = 1 AND deleted = 0;

-- Recordings to send: their note's memo exists to link them to.
toUpload:
SELECT recording.* FROM recording JOIN note ON note.id = recording.note_id
WHERE recording.deleted = 0 AND recording.on_server = 0 AND recording.downloaded = 1 AND note.on_server = 1 AND note.deleted = 0
ORDER BY recording.created_at, recording.id;

toDownload:
SELECT * FROM recording WHERE deleted = 0 AND downloaded = 0 ORDER BY created_at, id;

toDelete:
SELECT id FROM recording WHERE deleted = 1;

markDownloaded:
UPDATE recording SET downloaded = 1 WHERE id = ?;

markDeleted:
UPDATE recording SET deleted = 1 WHERE id = ?;

idsOfNote:
SELECT id FROM recording WHERE note_id = ?;

forgetServer:
UPDATE recording SET on_server = 0 WHERE note_id = ?;

forgetAllServers:
UPDATE recording SET on_server = 0;

purge:
DELETE FROM recording WHERE id = ?;
