<?xml version="1.0" encoding="utf-8"?>
<!-- xml/new_note_widget.xml with the preview and cell size Android 12 adds. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/capture_widget_description"
    android:initialLayout="@layout/widget_new_note"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_new_note"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
